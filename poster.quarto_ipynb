      },
      "source": [
        "#| echo: false\n",
        "#| label: fig-EC1\n",
        "#| fig-cap: Eddy covariance system with open path CO<sub>2</sub> and CH<sub>4</sub> sensors.\n",
        "import rawpy\n",
        "import imageio\n",
        "with rawpy.imread('G:/.shortcut-targets-by-id/1YLWq-5NMTYnDhdeL81TubtWXxOw4vmOm/SwissCheeseLake2024/DJI_20240719204941_0216_D.DNG') as raw:\n",
        "    rgb = raw.postprocess()\n",
        "  \n",
        "fig,ax=plt.subplots(figsize=(10,10))\n",
        "ax.imshow(rgb)\n",
        "ax.axis('off')\n",
        "a=1"
      ],
      "id": "fig-EC1",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "</div>\n",
        "\n",
        "\n",
        "# {.col-3 style=\"grid-row: span 4;\"} \n",
        "\n",
        "\n",
        "## Study Sites \n",
        "\n",
        "<div id=\"half\">\n",
        "\n",
        "The Mackenzie River Delta and surrounding upland terrain are shown in @fig-mac-delta.  \n",
        "\n",
        "* The region straddles the treeline and has a complex geologic history.\n",
        "* The region is the only part of the Canadian Arctic with road access. \n",
        "\n",
        "\n",
        "</div>\n"
      ],
      "id": "dab16aa5"
    },
    {
      "cell_type": "code",
      "metadata": {
        "fig-width": "100%"
      },
      "source": [
        "#| echo: false\n",
        "#| label: fig-mac-delta\n",
        "#| fig-cap: Eddy covariance sites and communities in the Mackenzie Delta Region.  Map corresponds to the inset in @fig-pan-arc\n",
        "\n",
        "# plt.figure(figsize=(4,4))\n",
        "# plt.plot([1,2],[1,2])\n",
        "\n",
        "import geodatasets\n",
        "import contextily as cx\n",
        "import matplotlib.patheffects as PathEffects\n",
        "\n",
        "communities = gpd.GeoDataFrame(index=[0,1,2],data={'Name':['Inuvik','Aklavik','Tuktoyaktuk']},geometry=gpd.points_from_xy(x=[-133.723819,-135.007480, -133.028379],y=[68.361515,68.221517,69.432860]),crs='WGS84')\n",
        "communities = communities.to_crs(epsg=32608)\n",
        "\n",
        "deltaBounds=deltaBounds.to_crs(epsg=32608)\n",
        "Sites = Sites.to_crs(epsg=32608)\n",
        "\n",
        "fig,ax=plt.subplots(figsize=(10,10))\n",
        "\n",
        "label = 'CO$_2$ & CH$_4$'\n",
        "marker = 'o'\n",
        "MS = 100\n",
        "kwargs={'color':color,'marker':marker,'markersize':MS,'edgecolor':'k'}\n",
        "Sites.loc[((Sites['CH4']==True))].plot(ax=ax,**kwargs)\n",
        "\n",
        "kwargs = {'color':'red','marker':marker,'markersize':MS,'edgecolor':'k'}\n",
        "communities.plot(ax=ax,**kwargs)\n",
        "\n",
        "\n",
        "TL_kwargs = {'color':'None',\n",
        "  'edgecolor':'green',\n",
        "  'linewidth':littleLine,\n",
        "  'label':'Arctic Treeline',\n",
        "  'linestyle':':'}\n",
        "Arctic = Arctic.to_crs(epsg=32608)\n",
        "Arctic.plot(ax=ax,**TL_kwargs)\n",
        "\n",
        "\n",
        "bubble_width = 5\n",
        "kwargs={\n",
        "  'ha':'center',\n",
        "  'va':'bottom',\n",
        "  'fontsize':labelFontSize,\n",
        "  'xytext':(0,10),\n",
        "  'textcoords':'offset points'\n",
        "}\n",
        "for i, txt in communities.iterrows():\n",
        "  txt = ax.annotate(txt.Name, (txt.geometry.x, txt.geometry.y), **kwargs)\n",
        "  txt.set_path_effects([PathEffects.withStroke(linewidth=bubble_width, foreground='white')])\n",
        "\n",
        "Sites['Site_ID'] = Sites['Site_ID'].astype(str)\n",
        "kwargs['va'] = 'top'\n",
        "kwargs['ha'] = 'left'\n",
        "kwargs['xytext'] = (0,-10)\n",
        "\n",
        "for i, txt in Sites.iterrows():\n",
        "  txt = ax.annotate(txt.Site_ID.split('-')[-1], (txt.geometry.x, txt.geometry.y), **kwargs)\n",
        "  txt.set_path_effects([PathEffects.withStroke(linewidth=bubble_width, foreground='white')])\n",
        "\n",
        "ax.set_ylim(deltaBounds.geometry.bounds.miny[0],deltaBounds.geometry.bounds.maxy[0])\n",
        "ax.set_xlim(deltaBounds.geometry.bounds.minx[0],deltaBounds.geometry.bounds.maxx[0])\n",
        "\n",
        "access_token=\"pk.eyJ1IjoianVuZXNwYWNlYm9vdHMiLCJhIjoiY2twY3g4aXloMWFlcDJzbXN3aG95aG5uZiJ9.mFiJt0MIfL1MiJ2rB2xhKQ\"\n",
        "tileurl = 'https://api.mapbox.com/v4/mapbox.satellite/{z}/{x}/{y}@2x.png?access_token=' + str(access_token)\n",
        "\n",
        "cx.add_basemap(ax, source=tileurl,zoom=8,crs=Sites.crs)#Mapbox\n",
        "\n",
        "# cx.add_basemap(ax, source=cx.providers.Esri.WorldImagery,zoom=8)#ESRI\n",
        "ax.axis('off')\n",
        "a=1"
      ],
      "id": "fig-mac-delta",
      "execution_count": null,
